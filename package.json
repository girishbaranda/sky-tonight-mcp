{
  "name": "sky-tonight",
  "version": "0.4.0",
  "description": "MCP server for personal astronomy — what's visible tonight, ISS passes, moon phases.",
  "type": "module",
  "bin": {
    "sky-tonight": "dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "tsx --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "astronomy-engine": "^2.1.19",
    "better-sqlite3": "^11.5.0",
    "satellite.js": "^7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
