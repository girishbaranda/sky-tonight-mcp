{
  "name": "@girishbaranda/sky-tonight",
  "version": "0.7.0",
  "description": "MCP server for personal astronomy — what's visible tonight, ISS passes, moon phases.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "sky-tonight": "dist/server.js"
  },
  "files": [
    "dist/",
    "migrations/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:http": "node dist/http.js",
    "dev": "tsx src/server.ts",
    "dev:http": "tsx src/http.ts",
    "mint-token": "tsx scripts/mint-dev-token.ts",
    "test": "tsx --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "astronomy-engine": "^2.1.19",
    "better-sqlite3": "^11.5.0",
    "jose": "^5.10.0",
    "pg": "^8.20.0",
    "satellite.js": "^7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "pg-mem": "^3.0.14",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
